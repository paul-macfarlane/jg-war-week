  "faqItems": [
    {
      "question": "I have some great pics and videos. Where do I put them?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Share to #war-week-xi on Slack, and get anything really good to Jet Breuer."
              }
            ]
          }
        ]
      }
    },
    {
      "question": "How do I record War Week time in Tense?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Billable work and learning time are recorded as always. Other productive time goes to JG - Admin; nonsense (video games, Beyblades) goes to JG - Team Building."
              }
            ]
          }
        ]
      }
    },
    {
      "question": "When are the hours cutoffs this year?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The billable hours cutoff is Thursday at midnight. There are no honor societies for overall hours this year."
              }
            ]
          }
        ]
      }
    },
    {
      "question": "What are the awards at this year's War Week?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Black Midnight, War Week MVPs (voted by each team) and Billable Hours Champs. There are no Centurion or Four Score Clubs this year."
              }
            ]
          }
        ]
      }
    },
    {
      "question": "Are we allowed to have personal guests at War Week?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Limit guests during working hours (Mon-Fri, 9 to 5). Evenings and Sunday are open, and Closing Ceremonies on Friday is the best time to bring a guest."
              }
            ]
          }
        ]
      }
    },
    {
      "question": "What about client or prospect guests?",
      "answer": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "They're very welcome. Let Jason know so the proper arrangements can be made."
              }
            ]
          }
        ]
      }
    }
  ],
