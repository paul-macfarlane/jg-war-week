DATABASE_URL=postgres://postgres:postgres@localhost:2345/war_weeker?sslmode=disable
# "pg" (default, local Postgres) or "neon" (production, Neon serverless driver)
DATABASE_DRIVER=pg

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# MCP access (/api/mcp) for clients without a browser session.
# MCP_TOKEN: shared bearer token; blank turns token auth off.
MCP_TOKEN=

# Test sign-in (/sign-in/test): sign in as any @jahnelgroup.com address
# without Google. Local and staging only, never Production (it is refused
# whenever VERCEL_ENV=production). At least 32 characters; blank turns it
# off. Generate with: openssl rand -base64 32
TEST_SIGN_IN_SECRET=
